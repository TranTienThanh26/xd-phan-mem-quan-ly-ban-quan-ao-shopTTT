<Window x:Class="CongNghenetBTL.GiaoDien.KhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TTT Store - Cửa Hàng Thời Trang Trực Tuyến" 
        Height="840" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- KHUNG CHÍNH CỬA SỔ BO GÓC CAO CẤP -->
    <Border CornerRadius="14" Background="{StaticResource MauNenChinhBrush}" Effect="{StaticResource BongNoiBat}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- THANH HEADER / ĐIỀU HƯỚNG -->
                <RowDefinition Height="*" />    <!-- NỘI DUNG CHÍNH (CÁC TAB) -->
                <RowDefinition Height="Auto" /> <!-- THANH THÔNG TIN DƯỚI ĐÁY -->
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- ROW 0: THANH HEADER CAO CẤP (TOP NAVBAR) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" Background="White" CornerRadius="14,14,0,0" BorderBrush="{StaticResource MauVienNheBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,12,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- BRAND LOGO -->
                        <ColumnDefinition Width="*" />    <!-- MENU TABS CHÍNH -->
                        <ColumnDefinition Width="Auto" /> <!-- TÌM KIẾM & GIỎ HÀNG & USER & WINDOW CONTROLS -->
                    </Grid.ColumnDefinitions>

                    <!-- LOGO THƯƠNG HIỆU -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource MauChinhNhatBrush}" Margin="0,0,10,0">
                            <TextBlock Text="👗" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TTT STORE" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource MauChinhBrush}" />
                            <TextBlock Text="Thời Trang Phong Cách &amp; Cao Cấp" FontSize="11" Foreground="{StaticResource MauChuPhuBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- MENU TABS ĐIỀU HƯỚNG KHÁCH HÀNG -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <RadioButton x:Name="tabNavMuaSam" Style="{StaticResource NutMenuBenTrai}" IsChecked="True" Checked="TabNav_Checked" Margin="4,0" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛍️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cửa Hàng / Mua Sắm" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabNavGioHang" Style="{StaticResource NutMenuBenTrai}" Checked="TabNav_Checked" Margin="4,0" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Giỏ Hàng" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border x:Name="badgeGioHang" Background="{StaticResource MauThoiTrangBrush}" CornerRadius="10" Margin="6,0,0,0" Padding="6,2" MinWidth="20" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtSoLuongBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabNavDonHang" Style="{StaticResource NutMenuBenTrai}" Checked="TabNav_Checked" Margin="4,0" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Đơn Hàng Của Tôi" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="tabNavTaiKhoan" Style="{StaticResource NutMenuBenTrai}" Checked="TabNav_Checked" Margin="4,0" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tài Khoản &amp; Bảo Mật" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- CỤM PHẢI: TÀI KHOẢN KHÁCH & NÚT ADMIN & WINDOW BUTTONS -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- THÔNG TIN TÀI KHOẢN KHÁCH HÀNG ĐANG ĐĂNG NHẬP -->
                        <Border x:Name="pnlKhachDaDangNhap" Background="{StaticResource MauChinhNhatBrush}" CornerRadius="20" Padding="12,5" Margin="0,0,12,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtTenKhachHeader" Text="Trần Minh Hoàng" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChinhBrush}" />
                                    <TextBlock x:Name="txtHangKhachHeader" Text="VIP (-10%) | 150 Điểm" FontSize="10" Foreground="{StaticResource MauChuPhuBrush}" />
                                </StackPanel>
                                <Button x:Name="btnDangXuatKhach" Content="Đăng xuất" Style="{StaticResource NutVien}" Height="28" Padding="8,0" Margin="10,0,0,0" FontSize="11" Click="BtnDangXuatKhach_Click" />
                            </StackPanel>
                        </Border>

                        <!-- NÚT ĐĂNG NHẬP / ĐĂNG KÝ CHO KHÁCH -->
                        <Button x:Name="btnMoDangNhapKhach" Style="{StaticResource NutChinh}" Height="36" Padding="14,0" Margin="0,0,10,0" Click="BtnMoDangNhapKhach_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Đăng Nhập / Đăng Ký" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- NÚT CHUYỂN SANG MÀN HÌNH QUẢN TRỊ / NHÂN VIÊN -->
                        <Button x:Name="btnChuyenSangAdmin" Style="{StaticResource NutPhu}" Height="36" Padding="12,0" Margin="0,0,14,0" ToolTip="Quay lại giao diện dành cho Quản lý &amp; Thu ngân" Click="BtnChuyenSangAdmin_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Quản Trị / POS" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- NÚT THU NHỎ & ĐÓNG CỬA SỔ -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource NutBieuTuong}" Content="—" Width="32" Height="32" Margin="0,0,4,0" Click="NutThuNho_Click" ToolTip="Thu nhỏ" />
                            <Button Style="{StaticResource NutBieuTuong}" Content="✕" Width="32" Height="32" Click="NutDong_Click" ToolTip="Đóng ứng dụng" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- ROW 1: KHUNG NỘI DUNG CHÍNH (CÁC TAB) -->
            <!-- ============================================== -->
            <Grid Grid.Row="1">
                <!-- ========================================== -->
                <!-- 1. TAB CỬA HÀNG / MUA SẮM (CATALOG & SHOP) -->
                <!-- ========================================== -->
                <Grid x:Name="pnlTabMuaSam" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- HERO PROMO BANNER -->
                        <RowDefinition Height="Auto" /> <!-- BỘ LỌC TÌM KIẾM, DANH MỤC, SIZE, GIÁ -->
                        <RowDefinition Height="*" />    <!-- DANH SÁCH SẢN PHẨM DẠNG CARD -->
                    </Grid.RowDefinitions>

                    <!-- HERO BANNER KHUYẾN MÃI THỜI TRANG CAO CẤP -->
                    <Border Grid.Row="0" Margin="20,16,20,12" CornerRadius="12" Height="190" ClipToBounds="True">
                        <Grid>
                            <!-- ẢNH NỀN BANNER THỜI TRANG THẬT -->
                            <Image Source="/HinhAnh/banner_thoi_trang.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            
                            <!-- LỚP GRADIENT MỜ CAO CẤP TẠO ĐỘ TƯƠNG PHẢN -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E60F172A" Offset="0" />
                                        <GradientStop Color="#B31E1B4B" Offset="0.55" />
                                        <GradientStop Color="#4D0F172A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- NỘI DUNG TRÊN BANNER -->
                            <Grid Margin="32,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource MauThoiTrangBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="🔥 BST THỜI TRANG MỚI 2026 - TTT BOUTIQUE" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="NÂNG TẦM PHONG CÁCH CỦA BẠN" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,0,0,6" />
                                    <TextBlock Text="Áo sơ mi lụa, Áo thun Polo Pique, Quần Jeans Vintage &amp; Váy đầm thiết kế cao cấp." FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,14" />
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#33FFFFFF" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock Text="🚚 Freeship đơn từ 500k" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <Border Background="#33FFFFFF" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock Text="⭐ VIP Giảm 10% Trực Tiếp" FontSize="11" FontWeight="SemiBold" Foreground="#FDE047" />
                                        </Border>
                                        <Border Background="#33FFFFFF" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="🔄 Đổi trả linh hoạt 7 ngày" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- THANH CÔNG CỤ BỘ LỌC SẢN PHẨM (DANH MỤC, SIZE, GIÁ, TÌM KIẾM) -->
                    <Border Grid.Row="1" Margin="20,0,20,12" Background="White" CornerRadius="10" Padding="16,12" Effect="{StaticResource BongTheCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- HÀNG 1: CHIP LỌC DANH MỤC THỜI TRANG -->
                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                <StackPanel x:Name="pnlDanhMucPills" Orientation="Horizontal">
                                    <!-- Nút Tất Cả -->
                                    <RadioButton x:Name="btnDMTatCa" Content="✨ Tất cả sản phẩm" Style="{StaticResource NutMenuBenTrai}" Height="34" Margin="0,0,6,0" IsChecked="True" Checked="FilterDanhMuc_Checked" Tag="0" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- HÀNG 2: TÌM KIẾM, LỌC SIZE, LỌC GIÁ, SẮP XẾP -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />    <!-- Ô TÌM KIẾM -->
                                    <ColumnDefinition Width="Auto" /> <!-- LỌC SIZE -->
                                    <ColumnDefinition Width="Auto" /> <!-- LỌC GIÁ -->
                                    <ColumnDefinition Width="Auto" /> <!-- SẮP XẾP -->
                                    <ColumnDefinition Width="Auto" /> <!-- NÚT LÀM MỚI -->
                                </Grid.ColumnDefinitions>

                                <!-- Ô TÌM KIẾM SẢN PHẨM -->
                                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="12,0" Height="38" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MauChuPhuBrush}" />
                                        <TextBox x:Name="txtTimKiemSanPham" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" VerticalContentAlignment="Center" KeyDown="TxtTimKiemSanPham_KeyDown" Tag="Nhập tên áo, quần, váy, màu sắc hoặc size để tìm..." />
                                        <Button Grid.Column="2" Content="Tìm" Style="{StaticResource NutChinh}" Height="28" Padding="10,0" FontSize="11" Click="BtnTimKiem_Click" />
                                    </Grid>
                                </Border>

                                <!-- LỌC THEO KÍCH CỠ (SIZE) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Size:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="cboLocSize" Width="105" Height="38" Style="{StaticResource OChonChuan}" SelectionChanged="Filter_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả" IsSelected="True" />
                                        <ComboBoxItem Content="S" />
                                        <ComboBoxItem Content="M" />
                                        <ComboBoxItem Content="L" />
                                        <ComboBoxItem Content="XL" />
                                        <ComboBoxItem Content="XXL" />
                                        <ComboBoxItem Content="Freesize" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- LỌC THEO MỨC GIÁ -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Giá:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="cboLocGia" Width="135" Height="38" Style="{StaticResource OChonChuan}" SelectionChanged="Filter_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả mức giá" IsSelected="True" />
                                        <ComboBoxItem Content="Dưới 300.000 đ" />
                                        <ComboBoxItem Content="300k - 500k" />
                                        <ComboBoxItem Content="Trên 500.000 đ" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- SẮP XẾP -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Sắp xếp:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="cboSapXep" Width="130" Height="38" Style="{StaticResource OChonChuan}" SelectionChanged="Filter_SelectionChanged">
                                        <ComboBoxItem Content="Mới nhất" IsSelected="True" />
                                        <ComboBoxItem Content="Giá tăng dần" />
                                        <ComboBoxItem Content="Giá giảm dần" />
                                        <ComboBoxItem Content="Tên A - Z" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- NÚT NẠP LẠI DỮ LIỆU TỪ ADMIN -->
                                <Button Grid.Column="4" Style="{StaticResource NutPhu}" Height="38" Padding="12,0" Click="BtnNapLaiDuLieu_Click" ToolTip="Tải lại danh sách sản phẩm mới nhất từ CSDL">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Làm Mới" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- DANH SÁCH SẢN PHẨM DẠNG CARD LƯỚI THỜI TRANG -->
                    <Border Grid.Row="2" Margin="20,0,20,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="txtKetQuaTimKiem" Text="Đang tải danh sách sản phẩm..." FontSize="13" Foreground="{StaticResource MauChuPhuBrush}" Margin="4,0,0,10" />

                                <!-- WRAP PANEL CHỨA TOÀN BỘ CARD VIEW SẢN PHẨM -->
                                <WrapPanel x:Name="wrapDanhSachSanPham" ItemWidth="285" Orientation="Horizontal" />

                                <!-- THÔNG BÁO KHI KHÔNG TÌM THẤY SẢN PHẨM NÀO -->
                                <Border x:Name="pnlKhongCoSanPham" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="40" HorizontalAlignment="Center" Margin="0,30,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                        <TextBlock Text="Không tìm thấy mẫu quần áo nào phù hợp!" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Vui lòng thử tìm từ khóa khác hoặc bấm nút 'Làm Mới' để xem toàn bộ sản phẩm." FontSize="13" Foreground="{StaticResource MauChuPhuBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                                        <Button Content="Xem Tất Cả Sản Phẩm" Style="{StaticResource NutChinh}" Width="190" HorizontalAlignment="Center" Click="BtnXemTatCa_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. TAB GIỎ HÀNG & THANH TOÁN (CART & CHECKOUT) -->
                <!-- ========================================== -->
                <Grid x:Name="pnlTabGioHang" Visibility="Collapsed" Margin="20,16,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" /> <!-- DANH SÁCH MÓN ĐÃ CHỌN -->
                        <ColumnDefinition Width="2*" /> <!-- HỘP THÔNG TIN GIAO HÀNG & THANH TOÁN -->
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: DANH SÁCH MÓN TRONG GIỎ HÀNG -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0" Effect="{StaticResource BongTheCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="🛒 Giỏ Hàng Mua Sắm Của Bạn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" />
                                <TextBlock x:Name="txtTongMonTrongGio" Text=" (0 món)" FontSize="14" Foreground="{StaticResource MauChuPhuBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- BẢNG DANH SÁCH CÁC MÓN HÀNG -->
                            <DataGrid x:Name="dgvGioHangKhach" Grid.Row="1" Style="{StaticResource BangDuLieu}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Sản phẩm" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="6,4">
                                                    <Border Width="42" Height="42" CornerRadius="6" Background="#F1F5F9" ClipToBounds="True" Margin="0,0,10,0">
                                                        <Image Source="{Binding DuongDanAnhDayDu, FallbackValue='/HinhAnh/mac_dinh.jpg'}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TenSP}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource MauChuChinhBrush}" />
                                                        <TextBlock Text="{Binding ThongTinChiTiet, StringFormat='Size: {0}'}" FontSize="11" Foreground="{StaticResource MauChuPhuBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0} đ}" Width="110" />

                                    <DataGridTemplateColumn Header="Số lượng" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="-" Width="26" Height="26" Style="{StaticResource NutVien}" Padding="0" Click="BtnGiamSoLuong_Click" Tag="{Binding MaSP}" />
                                                    <TextBlock Text="{Binding SoLuong}" FontSize="13" FontWeight="Bold" Width="32" TextAlignment="Center" VerticalAlignment="Center" />
                                                    <Button Content="+" Width="26" Height="26" Style="{StaticResource NutVien}" Padding="0" Click="BtnTangSoLuong_Click" Tag="{Binding MaSP}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} đ}" Width="120" />

                                    <DataGridTemplateColumn Header="Xóa" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" Style="{StaticResource NutBieuTuong}" Height="28" Width="28" Click="BtnXoaMonKhoiGio_Click" Tag="{Binding MaSP}" ToolTip="Xóa món này khỏi giỏ" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- NÚT DƯỚI BẢNG GIỎ HÀNG -->
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Button Content="← Tiếp Tục Chọn Thêm Đồ" Style="{StaticResource NutPhu}" HorizontalAlignment="Left" Click="BtnTiepTucMua_Click" />
                                <Button Content="Xóa Sạch Giỏ Hàng" Style="{StaticResource NutVien}" HorizontalAlignment="Right" Click="BtnXoaHetGioHang_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: FORM ĐIỀN THÔNG TIN NHẬN HÀNG & TÍNH TIỀN -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="22" Effect="{StaticResource BongTheCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📝 Thông Tin Giao Hàng &amp; Đặt Hàng" FontSize="17" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,16" />

                                <!-- HỌ TÊN -->
                                <TextBlock Text="Họ và tên người nhận:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtKhachDatHoTen" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,12" />

                                <!-- SỐ ĐIỆN THOẠI -->
                                <TextBlock Text="Số điện thoại nhận hàng:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtKhachDatSoDienThoai" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,12" />

                                <!-- ĐỊA CHỈ NHẬN HÀNG -->
                                <TextBlock Text="Địa chỉ giao hàng chi tiết:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtKhachDatDiaChi" Style="{StaticResource OVanBanChuan}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                                <!-- GHI CHÚ ĐƠN HÀNG -->
