                                <TextBox x:Name="txtKhachDatGhiChu" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,16" />

                                <!-- HÌNH THỨC THANH TOÁN -->
                                <TextBlock Text="Phương thức thanh toán:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,6" />
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="{StaticResource MauVienNheBrush}" BorderThickness="1" Margin="0,0,0,16">
                                    <StackPanel>
                                        <RadioButton x:Name="radCOD" Content="💵 Thanh toán tiền mặt khi nhận hàng (COD)" IsChecked="True" Margin="0,0,0,8" />
                                        <RadioButton x:Name="radChuyenKhoan" Content="💳 Chuyển khoản ngân hàng (Techcombank / MB)" Margin="0,0,0,8" Checked="RadPTTT_Checked" />
                                        <RadioButton x:Name="radThe" Content="🏦 Thẻ ATM nội địa / Quét mã QR" Checked="RadPTTT_Checked" />
                                        
                                        <!-- HỘP THÔNG TIN CHUYỂN KHOẢN KHI CHỌN -->
                                        <Border x:Name="pnlThongTinCK" Background="#EEF2FF" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="📌 STK: 1903688889999 - Ngân hàng MB Bank" FontWeight="Bold" Foreground="{StaticResource MauChinhBrush}" FontSize="12" />
                                                <TextBlock Text="Chủ TK: TTT STORE - NỘI DUNG: SĐT CỦA BẠN" FontSize="11" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- BẢNG TỔNG KẾT TÍNH TIỀN -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14" BorderBrush="{StaticResource MauVienNheBrush}" BorderThickness="1" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Tiền hàng tạm tính:" FontSize="13" Foreground="{StaticResource MauChuPhuBrush}" />
                                            <TextBlock x:Name="txtTamTinhTien" Text="0 đ" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock x:Name="lblGiamGiaThanhVien" Text="Giảm giá thành viên:" FontSize="13" Foreground="{StaticResource MauChuPhuBrush}" />
                                            <TextBlock x:Name="txtTienGiamGia" Text="-0 đ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauThoiTrangBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Phí vận chuyển:" FontSize="13" Foreground="{StaticResource MauChuPhuBrush}" />
                                            <TextBlock x:Name="txtPhiShip" Text="0 đ (Freeship)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauThanhCongBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Separator Margin="0,6" Background="{StaticResource MauVienNheBrush}" />
                                        <Grid>
                                            <TextBlock Text="TỔNG THANH TOÁN:" FontSize="14" FontWeight="Black" Foreground="{StaticResource MauChuChinhBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="txtTongThanhToan" Text="0 đ" FontSize="20" FontWeight="Black" Foreground="{StaticResource MauChinhBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- NÚT BẤM ĐẶT HÀNG NGAY -->
                                <Button x:Name="btnXacNhanDatHang" Content="🛍️ XÁC NHẬN ĐẶT HÀNG NGAY" Style="{StaticResource NutChinh}" Height="46" FontSize="15" FontWeight="Bold" Click="BtnXacNhanDatHang_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- 3. TAB ĐƠN HÀNG CỦA TÔI (MY ORDERS) -->
                <!-- ========================================== -->
                <Grid x:Name="pnlTabDonHang" Visibility="Collapsed" Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- KHUNG TRA CỨU ĐƠN HÀNG -->
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" Effect="{StaticResource BongTheCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📦 Tra Cứu Lịch Sử Đơn Mua Bằng SĐT:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBox x:Name="txtTraCuuSDT" Grid.Column="1" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,12,0" KeyDown="TxtTraCuuSDT_KeyDown" />
                            <Button Grid.Column="2" Content="🔍 Tra Cứu Đơn" Style="{StaticResource NutChinh}" Height="38" Padding="16,0" Click="BtnTraCuuDon_Click" />
                        </Grid>
                    </Border>

                    <!-- NỘI DUNG 2 CỘT: DANH SÁCH ĐƠN HÀNG & CHI TIẾT MÓN HÀNG TRONG ĐƠN -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- BẢNG LỊCH SỬ ĐƠN HÀNG -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" Effect="{StaticResource BongTheCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Danh Sách Đơn Hàng Của Bạn" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,10" />
                                <DataGrid x:Name="dgvLichSuDonKhach" Grid.Row="1" Style="{StaticResource BangDuLieu}" SelectionChanged="DgvLichSuDonKhach_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaHD, StringFormat=#HD{0}}" Width="80" />
                                        <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding NgayLap, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                                        <DataGridTextColumn Header="Thanh Toán" Binding="{Binding ThanhTien, StringFormat={}{0:N0} đ}" Width="110" />
                                        <DataGridTextColumn Header="Hình Thức" Binding="{Binding PhuongThucTT}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- CHI TIẾT MẶT HÀNG TRONG ĐƠN HÀNG ĐƯỢC CHỌN -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Effect="{StaticResource BongTheCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="txtTieuDeChiTietDon" Grid.Row="0" Text="Chi Tiết Các Món Trong Đơn (Chọn 1 đơn bên trái)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,10" />
                                <DataGrid x:Name="dgvChiTietDonKhach" Grid.Row="1" Style="{StaticResource BangDuLieu}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding TenSP}" Width="*" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding KichCo}" Width="60" />
                                        <DataGridTextColumn Header="Màu" Binding="{Binding MauSac}" Width="90" />
                                        <DataGridTextColumn Header="Số Lượng" Binding="{Binding SoLuong}" Width="70" />
                                        <DataGridTextColumn Header="Đơn Giá" Binding="{Binding DonGia, StringFormat={}{0:N0} đ}" Width="100" />
                                        <DataGridTextColumn Header="Thành Tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} đ}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- 4. TAB TÀI KHOẢN & BẢO MẬT (PROFILE & SECURITY) -->
                <!-- ========================================== -->
                <Grid x:Name="pnlTabTaiKhoan" Visibility="Collapsed" Margin="20,16,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" /> <!-- THẺ THÀNH VIÊN VÀ THÔNG TIN -->
                        <ColumnDefinition Width="1*" /> <!-- ĐỔI MẬT KHẨU BẢO MẬT SHA-256 -->
                    </Grid.ColumnDefinitions>

                    <!-- THẺ THÀNH VIÊN VÀ FORM CẬP NHẬT THÔNG TIN -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,12,0" Effect="{StaticResource BongTheCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="👑 Thẻ Thành Viên Điện Tử" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,16" />

                                <!-- CARD THÀNH VIÊN CAO CẤP DẠNG GRADIENT -->
                                <Border CornerRadius="12" Height="170" Margin="0,0,0,24" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4F46E5" Offset="0" />
                                            <GradientStop Color="#7C3AED" Offset="0.5" />
                                            <GradientStop Color="#DB2777" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Margin="20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="TTT STORE LOYALTY CARD" FontWeight="Bold" FontSize="13" Foreground="#E0E7FF" />
                                            <TextBlock x:Name="txtCardHangThanhVien" Text="⭐ HẠNG VIP" FontWeight="Black" FontSize="14" Foreground="#FDE047" HorizontalAlignment="Right" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtCardHoTen" Text="Trần Minh Hoàng" FontSize="20" FontWeight="Bold" Foreground="White" />
                                            <TextBlock x:Name="txtCardSoDienThoai" Text="SĐT Bảo Mật: 090****567" FontSize="13" Foreground="#E2E8F0" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <TextBlock x:Name="txtCardDiem" Text="Điểm Tích Lũy: 150 Điểm" FontWeight="Bold" FontSize="13" Foreground="White" />
                                            <TextBlock Text="Đặc Quyền: Giảm 10% Mọi Đơn" FontSize="12" Foreground="#FEF08A" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- CẬP NHẬT THÔNG TIN CÁ NHÂN -->
                                <TextBlock Text="Thông Tin Khách Hàng:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,12" />

                                <TextBlock Text="Họ và tên:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtProfileHoTen" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,12" />

                                <TextBlock Text="Số điện thoại (đã mã hóa bảo mật):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtProfileSoDienThoai" Style="{StaticResource OVanBanChuan}" Height="38" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,12" />

                                <TextBlock Text="Email liên hệ:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtProfileEmail" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,12" />

                                <TextBlock Text="Địa chỉ nhận hàng mặc định:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtProfileDiaChi" Style="{StaticResource OVanBanChuan}" Height="60" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <Button Content="💾 Lưu Cập Nhật Thông Tin" Style="{StaticResource NutChinh}" Height="40" Click="BtnLuuProfile_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- FORM ĐỔI MẬT KHẨU BẢO MẬT (SHA-256) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource BongTheCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🔒 Bảo Mật &amp; Đổi Mật Khẩu" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Mật khẩu của bạn được mã hóa một chiều bằng chuẩn an toàn SHA-256." FontSize="12" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,20" />

                                <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <TextBlock Text="🛡️ Lưu ý: Mật khẩu mới cần có tối thiểu 4 ký tự và không chia sẻ cho người khác." FontSize="12" Foreground="#92400E" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Text="Mật khẩu hiện tại:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="txtDoiMKCu" Style="{StaticResource OMatKhauChuan}" Height="38" Margin="0,0,0,14" />

                                <TextBlock Text="Mật khẩu mới:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="txtDoiMKMoi" Style="{StaticResource OMatKhauChuan}" Height="38" Margin="0,0,0,14" />

                                <TextBlock Text="Xác nhận mật khẩu mới:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="txtDoiMKXacNhan" Style="{StaticResource OMatKhauChuan}" Height="38" Margin="0,0,0,20" />

                                <Button Content="🔑 Xác Nhận Đổi Mật Khẩu" Style="{StaticResource NutChinh}" Height="42" Click="BtnDoiMatKhau_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- ROW 2: THANH STATUS BAR DƯỚI ĐÁY -->
            <!-- ============================================== -->
            <Border Grid.Row="2" Background="White" CornerRadius="0,0,14,14" BorderBrush="{StaticResource MauVienNheBrush}" BorderThickness="0,1,0,0" Padding="20,8">
                <Grid>
                    <TextBlock Text="© 2026 TTT STORE - Hệ Thống Bán Quần Áo Thời Trang Cao Cấp | Hotline: 1900 8888" FontSize="11" Foreground="{StaticResource MauChuPhuBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MauThanhCongBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Kết nối CSDL MySQL: Sẵn Sàng (Port 3306)" FontSize="11" Foreground="{StaticResource MauThanhCongBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- MODAL 1: XEM CHI TIẾT SẢN PHẨM (QUICK VIEW) -->
            <!-- ============================================== -->
            <Border x:Name="modalChiTietSP" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" MouseLeftButtonDown="ModalSP_BackgroundClick">
                <Border Background="White" CornerRadius="16" Width="680" MaxHeight="620" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" Effect="{StaticResource BongNoiBat}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- TIÊU ĐỀ & NÚT ĐÓNG MODAL -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="👗 Chi Tiết Sản Phẩm Thời Trang" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" />
                            <Button Style="{StaticResource NutBieuTuong}" Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Click="BtnDongModalSP_Click" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ẢNH LỚN SẢN PHẨM -->
                            <Border Grid.Column="0" CornerRadius="12" Background="#F1F5F9" ClipToBounds="True" Height="340" Margin="0,0,20,0">
                                <Image x:Name="imgModalAnhSP" Stretch="UniformToFill" />
                            </Border>

                            <!-- THÔNG TIN CHI TIẾT SẢN PHẨM -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border x:Name="pnlModalTagDM" Background="{StaticResource MauChinhNhatBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock x:Name="txtModalDanhMuc" Text="Áo Sơ Mi" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauChinhBrush}" />
                                </Border>

                                <TextBlock x:Name="txtModalTenSP" Text="Áo Sơ Mi Oxford Nam Dài Tay" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                
                                <TextBlock x:Name="txtModalGiaBan" Text="350.000 đ" FontSize="24" FontWeight="Black" Foreground="{StaticResource MauThoiTrangBrush}" Margin="0,0,0,14" />

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="txtModalSizeMau" Text="Kích cỡ: L | Màu sắc: Trắng" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="txtModalChatLieu" Text="Chất liệu vải: Cotton Oxford cao cấp" FontSize="12" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="txtModalTonKho" Text="Tồn kho: 45 cái" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauThanhCongBrush}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Mô tả sản phẩm:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,2" />
                                <TextBlock x:Name="txtModalMoTa" Text="Form dáng thanh lịch, thoáng mát cả ngày." FontSize="12" Foreground="{StaticResource MauChuChinhBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <!-- CHỌN SỐ LƯỢNG VÀ NÚT MUA -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="Số lượng:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0" />
                                    <Button Content="-" Width="32" Height="32" Style="{StaticResource NutVien}" Click="BtnModalGiamSL_Click" />
                                    <TextBox x:Name="txtModalSoLuongMua" Text="1" Width="45" Height="32" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="13" FontWeight="Bold" IsReadOnly="True" Margin="4,0" />
                                    <Button Content="+" Width="32" Height="32" Style="{StaticResource NutVien}" Click="BtnModalTangSL_Click" />
                                </StackPanel>

                                <Button x:Name="btnModalThemVaoGio" Content="🛒 Thêm Vào Giỏ Hàng" Style="{StaticResource NutChinh}" Height="44" FontSize="14" FontWeight="Bold" Click="BtnModalThemVaoGio_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- ============================================== -->
            <!-- MODAL 2: ĐĂNG NHẬP / ĐĂNG KÝ KHÁCH HÀNG (AUTH) -->
            <!-- ============================================== -->
            <Border x:Name="modalAuthKhachHang" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" MouseLeftButtonDown="ModalAuth_BackgroundClick">
                <Border Background="White" CornerRadius="16" Width="460" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" Effect="{StaticResource BongNoiBat}">
                    <StackPanel>
                        <!-- NÚT ĐÓNG -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tài Khoản Khách Hàng TTT Store" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource NutBieuTuong}" Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="BtnDongModalAuth_Click" />
                        </Grid>

                        <!-- CHỌN TAB ĐĂNG NHẬP HOẶC ĐĂNG KÝ -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="radTabAuthDangNhap" Grid.Column="0" Content="🔑 Đăng Nhập" Style="{StaticResource NutMenuBenTrai}" Height="38" IsChecked="True" Checked="RadAuthTab_Checked" />
                            <RadioButton x:Name="radTabAuthDangKy" Grid.Column="1" Content="📝 Đăng Ký Mới" Style="{StaticResource NutMenuBenTrai}" Height="38" Checked="RadAuthTab_Checked" />
                        </Grid>

                        <!-- KHUNG BÁO LỖI / THÀNH CÔNG -->
                        <Border x:Name="pnlAuthThongBao" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock x:Name="txtAuthThongBao" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <!-- NỘI DUNG FORM 1: ĐĂNG NHẬP -->
                        <StackPanel x:Name="pnlAuthDangNhapForm">
                            <TextBlock Text="Số điện thoại của bạn:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAuthDNTaiKhoan" Style="{StaticResource OVanBanChuan}" Height="40" Margin="0,0,0,12" />

                            <TextBlock Text="Mật khẩu:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="txtAuthDNMatKhau" Style="{StaticResource OMatKhauChuan}" Height="40" Margin="0,0,0,16" KeyDown="TxtAuthDNMatKhau_KeyDown" />

                            <Button Content="ĐĂNG NHẬP MUA SẮM" Style="{StaticResource NutChinh}" Height="42" FontSize="14" FontWeight="Bold" Margin="0,0,0,14" Click="BtnThucHienDangNhapKhach_Click" />

                            <!-- NÚT TEST NHANH TÀI KHOẢN KHÁCH VIP CHO THẦY CÔ CHẤM ĐIỂM -->
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="⚡ Nút thử nghiệm nhanh tài khoản khách VIP:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,6" />
                                    <Button Content="Điền Khách VIP mẫu (Trần Minh Hoàng - 0901234567)" Style="{StaticResource NutVien}" Height="30" FontSize="11" Click="BtnDienKhachVIPMau_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- NỘI DUNG FORM 2: ĐĂNG KÝ TÀI KHOẢN MỚI -->
                        <StackPanel x:Name="pnlAuthDangKyForm" Visibility="Collapsed">
                            <TextBlock Text="Họ và tên của bạn:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAuthDKHoTen" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,10" />

                            <TextBlock Text="Số điện thoại (dùng đăng nhập):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAuthDKSoDienThoai" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,10" />

                            <TextBlock Text="Mật khẩu bảo mật (tối thiểu 4 ký tự):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="txtAuthDKMatKhau" Style="{StaticResource OMatKhauChuan}" Height="38" Margin="0,0,0,10" />

                            <TextBlock Text="Xác nhận mật khẩu:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="txtAuthDKXacNhanMK" Style="{StaticResource OMatKhauChuan}" Height="38" Margin="0,0,0,10" />

                            <TextBlock Text="Địa chỉ nhận hàng (tùy chọn):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="txtAuthDKDiaChi" Style="{StaticResource OVanBanChuan}" Height="38" Margin="0,0,0,16" />

                            <Button Content="ĐĂNG KÝ THÀNH VIÊN NGAY" Style="{StaticResource NutChinh}" Height="42" FontSize="14" FontWeight="Bold" Click="BtnThucHienDangKyKhach_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
