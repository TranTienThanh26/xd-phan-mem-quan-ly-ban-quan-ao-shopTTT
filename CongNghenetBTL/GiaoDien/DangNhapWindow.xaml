<Window x:Class="CongNghenetBTL.GiaoDien.DangNhapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng Nhập - TTT Store Quản Lý Bán Quần Áo" 
        Height="590" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="CuaSo_MouseLeftButtonDown">

    <!-- KHUNG CHÍNH BO GÓC CÓ ĐỔ BÓNG -->
    <Border CornerRadius="16" Background="White" Effect="{StaticResource BongNoiBat}" Margin="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT BÊN TRÁI: BANNER THƯƠNG HIỆU SHOP THỜI TRANG -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0" />
                        <GradientStop Color="#4338CA" Offset="0.5" />
                        <GradientStop Color="#1E1B4B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- LOGO & TÊN SHOP -->
                    <StackPanel Grid.Row="0">
                        <Border Width="56" Height="56" CornerRadius="14" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="👗" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="TTT STORE" FontSize="24" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PhongChuChinh}" />
                        <TextBlock Text="HỆ THỐNG QUẢN LÝ BÁN QUẦN ÁO" FontSize="12.5" FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- CÁC TÍNH NĂNG NỔI BẬT CỦA PHẦN MỀM -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,0">
                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" FontSize="16" Foreground="#FDE047" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quản lý chi tiết Size, Màu sắc &amp; Chất liệu" FontSize="13" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bán hàng nhanh, in hóa đơn &amp; giảm giá" FontSize="13" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm soát kho hàng, hạn chế thất thoát" FontSize="13" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thống kê doanh thu &amp; khách hàng thân thiết" FontSize="13" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CHÚ THÍCH BTL -->
                    <TextBlock Grid.Row="2" Text="BTL Môn Công Nghệ .NET (C# - WPF - ADO.NET)" 
                               FontSize="11" Foreground="#C7D2FE" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- CỘT BÊN PHẢI: FORM ĐĂNG NHẬP -->
            <Grid Grid.Column="1" Margin="36,20,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Nút thu nhỏ/đóng -->
                    <RowDefinition Height="Auto" /> <!-- Tiêu đề form -->
                    <RowDefinition Height="*" />    <!-- Form nhập -->
                    <RowDefinition Height="Auto" /> <!-- Footer chọn mẫu & đăng ký -->
                </Grid.RowDefinitions>

                <!-- NÚT ĐIỀU KHIỂN CỬA SỔ -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-16,0">
                    <Button Style="{StaticResource NutThuNhoCuaSo}" Click="NutThuNho_Click" />
                    <Button Style="{StaticResource NutDongCuaSo}" Click="NutDong_Click" />
                </StackPanel>

                <!-- TIÊU ĐỀ FORM -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="Đăng Nhập Quản Trị Viên" FontSize="25" FontWeight="Bold" Foreground="{StaticResource MauChuChinhBrush}" />
                    <TextBlock Text="Dành cho Quản trị viên (Admin) quản lý cửa hàng và hệ thống" FontSize="13" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,5,0,0" />
                </StackPanel>

                <!-- FORM NHẬP THÔNG TIN -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <!-- THÔNG BÁO KẾT QUẢ -->
                    <Border x:Name="pnlThongBao" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="iconThongBao" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtThongBao" Text="Thông báo lỗi" FontSize="12.5" Foreground="#DC2626" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- TÊN ĐĂNG NHẬP -->
                    <TextBlock Text="Tên đăng nhập Admin" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="txtTenDangNhap" Style="{StaticResource OVanBan}" KeyDown="TxtTenDangNhap_KeyDown" Padding="36,0,10,0" />
                        <TextBlock Text="👤" FontSize="15" Foreground="{StaticResource MauChuMoBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- MẬT KHẨU -->
                    <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinhBrush}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="txtMatKhau" Style="{StaticResource OMatKhau}" KeyDown="TxtMatKhau_KeyDown" Padding="36,0,40,0" PasswordChar="●" />
                        <TextBox x:Name="txtMatKhauHienThi" Style="{StaticResource OVanBan}" KeyDown="TxtMatKhau_KeyDown" Padding="36,0,40,0" Visibility="Collapsed" />
                        <TextBlock Text="🔒" FontSize="15" Foreground="{StaticResource MauChuMoBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                        
                        <!-- NÚT ẨN/HIỆN MẬT KHẨU -->
                        <Button x:Name="btnTogglePassword" Content="👁️" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ẩn / Hiện mật khẩu" Click="BtnTogglePassword_Click" />
                    </Grid>

                    <!-- TÙY CHỌN GHI NHỚ -->
                    <Grid Margin="0,0,0,20">
                        <CheckBox x:Name="chkRememberMe" Content="Ghi nhớ tài khoản" FontSize="12.5" Foreground="{StaticResource MauChuPhuBrush}" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Hyperlink Click="HyperlinkQuenMatKhau_Click" Foreground="{StaticResource MauChinhBrush}" TextDecorations="{x:Null}">
                                Quên mật khẩu?
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!-- NÚT ĐĂNG NHẬP ADMIN -->
                    <Button x:Name="btnDangNhap" Style="{StaticResource NutChinh}" Content="👑 ĐĂNG NHẬP QUẢN TRỊ VIÊN (ADMIN)" Click="BtnDangNhap_Click" />

                    <!-- NÚT MỞ GIAO DIỆN MUA SẮM KHÁCH HÀNG -->
                    <Button x:Name="btnVaoMuaSamKhach" Content="🛍️ VÀO CỬA HÀNG MUA SẮM (KHÁCH HÀNG)" 
                            Style="{StaticResource NutPhu}" Height="42" Margin="0,10,0,0" 
                            Foreground="{StaticResource MauThoiTrangBrush}" BorderBrush="{StaticResource MauThoiTrangBrush}" 
                            FontWeight="Bold" FontSize="13" Cursor="Hand" Click="BtnVaoMuaSamKhach_Click" />
                </StackPanel>

                <!-- FOOTER: CHỌN MẪU & GHI CHÚ TÁC NHÂN -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <!-- TÀI KHOẢN MẪU DỄ CHẤM ĐIỂM -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="💡 Bấm nhanh để kiểm tra phần mềm:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhuBrush}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="👑 Điền mẫu Admin (admin / 123456)" Margin="0,0,8,0" Padding="10,5" FontSize="11.5" FontWeight="SemiBold"
                                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="NutMauAdmin_Click"/>
                                <Button Content="🚀 Vào Thẳng Quản Trị" Padding="10,5" FontSize="11.5" FontWeight="SemiBold"
                                        Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE" BorderThickness="1" Cursor="Hand" Click="NutVaoThangTrangChu_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- GHI CHÚ 2 TÁC NHÂN -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="8,6">
                        <TextBlock Text="✨ Hệ thống gồm 2 tác nhân chính: Quản trị viên (Admin) và Khách hàng mua sắm." 
                                   FontSize="11.5" Foreground="{StaticResource MauChuPhuBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
